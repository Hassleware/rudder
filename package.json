{
  "name": "gemma-firefox-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('extension/vendor',{recursive:true});fs.copyFileSync('node_modules/@mlc-ai/web-llm/lib/index.js','extension/vendor/web-llm.js');for(const f of ['ort.webgpu.bundle.min.mjs','ort-wasm-simd-threaded.asyncify.wasm'])fs.copyFileSync('node_modules/onnxruntime-web/dist/'+f,'extension/vendor/'+f)\"",
    "start": "web-ext run",
    "lint": "web-ext lint --ignore-files \"vendor/**\"",
    "build": "web-ext build --overwrite-dest"
  },
  "devDependencies": {
    "web-ext": "10.8.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "onnxruntime-web": "^1.30.0"
  }
}
